# Copy this file to .env (in this folder, or one folder above it) and fill in the key. Never commit a real .env.
# Required: your Portkey API key (the only key RxLantern needs; it uses gpt-6-luna through Portkey).
PORTKEY_API_KEY=

# Optional: emails (comma-separated) that can approve or reject comments in the moderation queue.
# Leave empty for no admins (nothing breaks).
RXLANTERN_ADMIN_EMAILS=

# Optional: show the demonstration posts marked "Sample" (1 = on, the default; 0 = off).
RXLANTERN_SHOW_SAMPLE_DATA=1

# Optional: the port the app listens on (default 8000).
RXLANTERN_PORT=
